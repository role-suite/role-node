{
  "name": "role-node",
  "version": "1.0.0",
  "description": "role server written in node",
  "main": "dist/server.js",
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "build": "tsc",
    "contracts:breaking-check": "tsx scripts/contracts/breaking-check.ts",
    "contracts:check": "tsx scripts/contracts/check.ts",
    "contracts:docs-check": "tsx scripts/contracts/docs-check.ts",
    "contracts:generate": "tsx scripts/contracts/generate.ts",
    "contracts:openapi:check": "tsx scripts/contracts/openapi-check.ts",
    "contracts:openapi:generate": "tsx scripts/contracts/export-openapi.ts",
    "contracts:openapi:lint": "tsx scripts/contracts/openapi-lint.ts",
    "create:module": "node scripts/create-module.mjs",
    "db:reset:docker": "docker compose down -v && docker compose up -d",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:migrate:up": "tsx scripts/migrate.ts up",
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "grpc:check": "pnpm grpc:generate && git diff --exit-code -- src/grpc/generated",
    "grpc:bundle": "mkdir -p artifacts/grpc-proto && tar -czf artifacts/grpc-proto/role-v1-proto.tar.gz proto && shasum -a 256 artifacts/grpc-proto/role-v1-proto.tar.gz > artifacts/grpc-proto/SHA256SUMS",
    "grpc:generate": "mkdir -p src/grpc/generated .grpc-tmp && pbjs -t static-module -w es6 -o .grpc-tmp/role.pb.js proto/*.proto && pbts -o src/grpc/generated/role.pb.d.ts .grpc-tmp/role.pb.js",
    "grpc:test": "vitest --run tests/unit/grpc-*.test.ts tests/integration/grpc.integration.test.ts",
    "grpc:test:integration": "vitest --run tests/integration/grpc.integration.test.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest --run",
    "typecheck": "tsc --noEmit",
    "verify:grpc": "pnpm grpc:check && pnpm grpc:test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm contracts:check && pnpm contracts:openapi:check && pnpm verify:grpc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/role-suite/role-node.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bugs": {
    "url": "https://github.com/role-suite/role-node/issues"
  },
  "homepage": "https://github.com/role-suite/role-node#readme",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.0.1",
    "globals": "^16.4.0",
    "nodemon": "^3.1.14",
    "protobufjs-cli": "^1.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
