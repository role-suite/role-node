{
  "name": "role-node",
  "version": "1.0.0",
  "description": "role server written in node",
  "main": "dist/server.js",
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "build": "tsc",
    "contracts:breaking-check": "tsx scripts/contracts/breaking-check.ts",
    "contracts:check": "tsx scripts/contracts/check.ts",
    "contracts:docs-check": "tsx scripts/contracts/docs-check.ts",
    "contracts:generate": "tsx scripts/contracts/generate.ts",
    "contracts:openapi:check": "tsx scripts/contracts/openapi-check.ts",
    "contracts:openapi:generate": "tsx scripts/contracts/export-openapi.ts",
    "contracts:openapi:lint": "tsx scripts/contracts/openapi-lint.ts",
    "create:module": "node scripts/create-module.mjs",
    "db:reset:docker": "docker compose down -v && docker compose up -d",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:migrate:up": "tsx scripts/migrate.ts up",
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "grpc:check": "pnpm grpc:generate && git diff --exit-code -- src/grpc/generated",
    "grpc:bundle": "mkdir -p artifacts/grpc-proto && tar -czf artifacts/grpc-proto/role-v1-proto.tar.gz proto && shasum -a 256 artifacts/grpc-proto/role-v1-proto.tar.gz > artifacts/grpc-proto/SHA256SUMS",
    "grpc:generate": "mkdir -p src/grpc/generated .grpc-tmp && pbjs -t static-module -w es6 -o .grpc-tmp/role.pb.js proto/*.proto && pbts -o src/grpc/generated/role.pb.d.ts .grpc-tmp/role.pb.js",
    "grpc:test": "vitest --run tests/unit/grpc-*.test.ts tests/integration/grpc.integration.test.ts",
    "grpc:test:integration": "vitest --run tests/integration/grpc.integration.test.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest --run",
    "telemetry:up": "docker compose up -d otel-collector prometheus tempo loki grafana alertmanager",
    "telemetry:down": "docker compose stop otel-collector prometheus tempo loki grafana alertmanager",
    "telemetry:logs": "docker compose logs -f otel-collector prometheus tempo loki grafana alertmanager",
    "telemetry:test": "vitest --run tests/unit/telemetry-*.test.ts tests/unit/otel-collector-config.test.ts tests/unit/observability-retention-config.test.ts tests/unit/env-telemetry-validation.test.ts tests/integration/telemetry-*.integration.test.ts",
    "telemetry:validate": "docker compose config && docker run --rm --entrypoint promtool -v \"$PWD/config/observability/prometheus:/etc/prometheus:ro\" prom/prometheus:v2.54.1 check rules /etc/prometheus/alerts.yml && docker run --rm --entrypoint amtool -v \"$PWD/config/observability/alertmanager:/etc/alertmanager:ro\" prom/alertmanager:v0.27.0 check-config /etc/alertmanager/alertmanager.yml",
    "verify:telemetry": "pnpm telemetry:test && pnpm telemetry:validate",
    "typecheck": "tsc --noEmit",
    "verify:grpc": "pnpm grpc:check && pnpm grpc:test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm contracts:check && pnpm contracts:openapi:check && pnpm verify:grpc && pnpm verify:telemetry"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/role-suite/role-node.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bugs": {
    "url": "https://github.com/role-suite/role-node/issues"
  },
  "homepage": "https://github.com/role-suite/role-node#readme",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.5",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.14",
    "protobufjs-cli": "^1.3.3",
    "prettier": "^3.9.4",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
