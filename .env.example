NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=6321
DB_USER=role_user
DB_PASSWORD=role_pass
DB_NAME=role_node
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_SSL=false
ENABLE_STARTUP_VALIDATION=true
REQUEST_BODY_LIMIT=1mb
AUTH_ACCESS_TOKEN_SECRET=dev-access-secret-change-me
AUTH_REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
SERVER_HEADERS_TIMEOUT_MS=60000
SERVER_REQUEST_TIMEOUT_MS=300000
# false (no proxy in front), a number of trusted hops (e.g. 1 for a single
# reverse proxy/load balancer), or a comma-separated list of IPs/CIDRs/
# keywords Express understands (see the "trust proxy" setting docs).
TRUST_PROXY=false
