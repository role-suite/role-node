NODE_ENV=development
PORT=3000
GRPC_ENABLED=false
GRPC_PORT=50051
GRPC_TLS_ENABLED=false
GRPC_MTLS_ENABLED=false
# GRPC_TLS_CERT_PATH=/absolute/path/to/server.crt
# GRPC_TLS_KEY_PATH=/absolute/path/to/server.key
# GRPC_TLS_CA_PATH=/absolute/path/to/ca.crt
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_SSL=false
ENABLE_STARTUP_VALIDATION=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=role-node
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORT_INTERVAL_MS=30000
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_SAMPLER_RATIO=1
AUTH_ACCESS_TOKEN_SECRET=dev-access-secret-change-me
AUTH_REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
