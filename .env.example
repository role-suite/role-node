NODE_ENV=development
PORT=3000
GRPC_ENABLED=false
GRPC_PORT=50051
GRPC_TLS_ENABLED=false
GRPC_MTLS_ENABLED=false
# GRPC_TLS_CERT_PATH=/absolute/path/to/server.crt
# GRPC_TLS_KEY_PATH=/absolute/path/to/server.key
# GRPC_TLS_CA_PATH=/absolute/path/to/ca.crt
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_SSL=false
ENABLE_STARTUP_VALIDATION=true
AUTH_ACCESS_TOKEN_SECRET=dev-access-secret-change-me
AUTH_REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
